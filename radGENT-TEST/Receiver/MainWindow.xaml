<Window x:Class="TextPinMvp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:TextPinMvp.Services"
        Title="Text-Pinning MVP (Debug)" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="LogItemStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success">
                    <Setter Property="Foreground" Value="#4EC9B0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter Property="Foreground" Value="#DCDCAA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="#F48771"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Detail">
                    <Setter Property="Foreground" Value="#9C9C9C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / instructions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Text-Pinning MVP"/>
            <TextBlock Foreground="#666" TextWrapping="Wrap"
                       Text="Workflow: 1) In ein Textfeld einer beliebigen App klicken. 2) F10 druecken (Feld fixieren). 3) F11 druecken oder Button (Text lesen, Woerter umdrehen, zurueckschreiben). Alle Schritte erscheinen im Log."/>
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="1" Background="#F0F0F0" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Fixiertes Ziel:" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Text="(kein Ziel fixiert)" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Empfangener Kontext (von externer App via radgent:// oder Kommandozeile) -->
        <Border Grid.Row="2" Background="#EAF3FF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Empfangener Kontext:" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="ContextId: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="ContextIdText" Text="(noch kein Kontext)" FontFamily="Consolas"/>
                </StackPanel>
                <TextBlock x:Name="ContextInfoText" Text="" TextWrapping="Wrap" Foreground="#333" Margin="0,2,0,0"/>
                <TextBlock x:Name="ContextMetaText" Text="" Foreground="#777" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="PinButton" Content="Feld fixieren (F10)" Padding="10,5" Margin="0,0,8,0" Click="PinButton_Click"/>
            <Button x:Name="TransformButton" Content="Transformieren (F11)" Padding="10,5" Margin="0,0,8,0" Click="TransformButton_Click"/>
            <Button x:Name="ReadButton" Content="Nur lesen" Padding="10,5" Margin="0,0,8,0" Click="ReadButton_Click"/>
            <Button x:Name="ClearTargetButton" Content="Ziel loeschen" Padding="10,5" Margin="0,0,8,0" Click="ClearTargetButton_Click"/>
            <Button x:Name="CopyLogButton" Content="Log kopieren" Padding="10,5" Margin="0,0,8,0" Click="CopyLogButton_Click"/>
            <Button x:Name="ClearLogButton" Content="Log leeren" Padding="10,5" Click="ClearLogButton_Click"/>
        </StackPanel>

        <!-- Main area: live mirror (left) + log (right) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.4*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Live mirror -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Live-Spiegel des Zielfeldes" Foreground="#DDDDDD" FontWeight="Bold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="MirrorToggle" Grid.Column="1" Content="aktiv" IsChecked="True"
                                  Foreground="#DDDDDD" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="MirrorStatus" DockPanel.Dock="Top" Margin="6,0,6,4"
                               Foreground="#9C9C9C" FontSize="11" TextWrapping="Wrap" Text="(kein Ziel fixiert)"/>
                    <TextBox x:Name="MirrorText" Margin="6,0,6,6"
                             Background="#111111" Foreground="#DCDCDC" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- Log -->
            <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="4">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="2,0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Style="{StaticResource LogItemStyle}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="5" Margin="0,6,0,0" Foreground="#999" FontSize="11" TextWrapping="Wrap"
                   Text="Hinweis: Bei Ziel-Apps mit hoeheren Rechten (als Admin gestartet) schlagen Lesen/Schreiben/Paste fehl (UIPI). contenteditable im Browser / Electron koennen nur ueber den Clipboard-Fallback funktionieren."/>
    </Grid>
</Window>
