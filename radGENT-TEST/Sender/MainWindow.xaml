<Window x:Class="SenderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontext-Sender (Test)" Height="560" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Kontext-Sender (Test)"/>
            <TextBlock Foreground="#666" TextWrapping="Wrap"
                       Text="Simuliert eine fremde Anwendung, die der Receiver-App einen Kontext signalisiert - entweder ueber das Custom-URI-Schema (radgent://) oder ueber den Start der Receiver-EXE mit Argumenten."/>
        </StackPanel>

        <!-- Inputs -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ContextId:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox x:Name="ContextIdBox" Grid.Row="0" Grid.Column="1" Text="12345" Margin="0,0,0,6" Padding="4,3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Info (optional):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="InfoBox" Grid.Row="1" Grid.Column="1" Text="Mustermann, Max" Padding="4,3"/>
        </Grid>

        <!-- Receiver path -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Receiver-EXE:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ReceiverPathBox" Grid.Column="1" Padding="4,3"
                     ToolTip="Pfad zur TextPinMvp.exe (nur fuer die Argument-Methode noetig)"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SendUriButton" Content="Senden via URI (radgent://)" Padding="10,6" Margin="0,0,8,0" Click="SendUriButton_Click"/>
            <Button x:Name="SendArgButton" Content="Senden via Argument (EXE-Start)" Padding="10,6" Margin="0,0,8,0" Click="SendArgButton_Click"/>
            <Button x:Name="ClearLogButton" Content="Log leeren" Padding="10,6" Click="ClearLogButton_Click"/>
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="4">
            <ListBox x:Name="LogList" Background="Transparent" Foreground="#DCDCDC" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#DCDCDC"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</Window>
